{
  "name": "sellflow",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "//overrides": "Build-blocking fix, not a preference. `react-dom` is an OPTIONAL peer of `expo` (web only) and floats to 19.3.0, whose peer range `react@^19.3.0` conflicts with the `react@19.2.3` that Expo SDK 57 / RN 0.86.3 require. `npm ci` on EAS is strict and aborts, so the cloud build dies in INSTALL_DEPENDENDENCIES before Gradle ever runs. SellFlow is mobile-only and never loads react-dom, so pinning it to the matching React version changes nothing at runtime. Removing this will break `eas build`.",
  "overrides": {
    "react-dom": "19.2.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "dev:web": "expo start --web",
    "dev:web:phone": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "db:up": "docker run -d --name sellflow-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=sellflow -p 55432:5432 postgres:16-alpine",
    "db:down": "docker rm -f sellflow-pg",
    "db:migrate": "docker exec -i sellflow-pg psql -q -U postgres -d sellflow -v ON_ERROR_STOP=1 -f supabase/test/auth_shim.sql",
    "db:test": "node scripts/run-db-tests.mjs",
    "eas:verify": "node scripts/resolve-eas-profiles.mjs",
    "supabase:connect": "node scripts/connect-supabase.mjs",
    "test:connectivity": "node --import ./scripts/register-loader.mjs --test scripts/connectivity.test.mjs",
    "test:outbox": "node --import ./scripts/register-loader.mjs --test scripts/outbox.test.mjs",
    "test:errors": "node --import ./scripts/register-loader.mjs --test scripts/errors.test.mjs",
    "test:money": "node --import ./scripts/register-loader.mjs --test scripts/money.test.mjs",
    "test:money-format": "node --import ./scripts/register-loader.mjs --test scripts/money-format.test.mjs",
    "test:order-form": "node --import ./scripts/register-loader.mjs --test scripts/order-form.test.mjs",
    "test:finance-wording": "node --import ./scripts/register-loader.mjs --test scripts/finance-wording.test.mjs",
    "design:audit": "node --import ./scripts/register-loader.mjs scripts/design-audit.mjs",
    "design:visual": "node --import ./scripts/register-loader.mjs scripts/visual-system-audit.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:connectivity && npm run test:outbox && npm run test:errors && npm run test:money && npm run test:money-format && npm run test:finance-wording && npm run test:order-form && npm run design:audit && npm run design:visual && npm run db:test"
  },
  "private": true
}
