# ---------------------------------------------------------------------------
# SellFlow environment configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project.
# `.env` is git-ignored and must NEVER be committed.
#
# NEVER put the Supabase `service_role` key in this file or anywhere in the
# client bundle. The service role key bypasses Row Level Security, so leaking it
# would expose every tenant's business data. Everything in the app runs as the
# authenticated `anon` / `authenticated` role and is constrained by RLS.
# ---------------------------------------------------------------------------

# From: Supabase dashboard -> Project Settings -> Data API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The public anon key. Safe to ship in the client ONLY because RLS is enabled.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Only used by the local dev seed script, never by the app.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
