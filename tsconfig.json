{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@/*": ["./src/*"],
      "@sellflow-sms": ["./modules/sellflow-sms/index.ts"],
      "@sellflow-sms/*": ["./modules/sellflow-sms/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "modules/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    "dist",
    "web-build",
    "supabase/functions"
  ]
}
